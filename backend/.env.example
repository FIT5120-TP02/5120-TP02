# --- Database (shared MySQL / AWS RDS) ---
# Same instance and same env var names as the repo-root db.py, so both
# files stay pointed at one database. Defaults below already match the
# team's shared instance - you only need to supply DB_PASSWORD.
DB_HOST=tp02fit5120.c1qymwwke45u.ap-southeast-2.rds.amazonaws.com
DB_PORT=3306
DB_USER=admin
DB_NAME=onboarding
DB_PASSWORD=
# Ask the team for DB_PASSWORD - deliberately not committed to the repo.

# No auth/JWT env vars - the product has no account/login system (team
# decision: removed for privacy, per tutor's guidance). Every endpoint is
# public/anonymous.

# --- Routing service (US 1.1 / 1.2) ---
# "mock"             - built-in fixture routes, no external call, no key needed.
# "openrouteservice" - real walking routes, hosted, free tier (2000 req/day).
#                       Get a free key: https://openrouteservice.org/dev/#/signup
#                       then set ROUTING_PROVIDER=openrouteservice and
#                       ROUTING_SERVICE_API_KEY below.
# "osrm"              - self-hosted OSRM, needs ROUTING_SERVICE_URL pointed
#                       at your own running instance (not set up yet).
ROUTING_PROVIDER=mock
ROUTING_SERVICE_URL=http://localhost:5001
ROUTING_SERVICE_API_KEY=

# No CROWD_HIGH_THRESHOLD_MULTIPLIER / MIN_BASELINE_OBSERVATIONS /
# SENSOR_MATCH_RADIUS_KM / LOCAL_TIMEZONE env vars here anymore - DS3's
# approved sensory_scoring.py::ScoringConfig owns all of these now (buffer
# radius, HIGH thresholds, minimum observations, staleness window, and a
# hardcoded Australia/Melbourne timezone), with its own defaults. It's
# meant to load overrides from the shared DB's `config` table rather than
# from env vars, so DS2 can tune it without a redeploy.

# --- CORS ---
FRONTEND_ORIGIN=http://localhost:5173
